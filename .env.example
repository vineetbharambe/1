# Environment variables for SkillSwap

# --- LOCAL DEVELOPMENT (SQLite) ---
DB_PROVIDER=sqlite
DATABASE_URL=file:./dev.db

# --- PRODUCTION (Neon PostgreSQL) ---
# Uncomment and fill these for Vercel:
# DB_PROVIDER=postgresql
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true&connect_timeout=15
