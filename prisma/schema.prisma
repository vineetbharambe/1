// SkillSwap Prisma Schema
// LOCAL DEV: provider = "sqlite", DATABASE_URL = "file:./dev.db"
// PRODUCTION: Change provider to "postgresql", set DATABASE_URL to your Neon connection string.
// Note: Prisma does not support dynamic provider switching via env() — 
// for production deploy, swap the provider value below before running prisma migrate deploy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Change to "postgresql" for production (Neon/Vercel)
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Gig {
  id                 String    @id @default(cuid())
  creatorName        String
  title              String
  category           String
  rate               Float
  description        String
  concurrentCapacity Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  bookings           Booking[]
}

model Booking {
  id            String         @id @default(cuid())
  gigId         String
  gig           Gig            @relation(fields: [gigId], references: [id], onDelete: Cascade)
  clientName    String
  note          String?
  status        String         @default("Pending")
  declineReason String?
  requestedAt   DateTime       @default(now())
}

